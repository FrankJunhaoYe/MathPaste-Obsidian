{
  "name": "mathpaste-obsidian",
  "version": "0.1.0",
  "private": true,
  "description": "Local math delimiter conversion for Obsidian on Windows.",
  "type": "module",
  "main": "main.js",
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FrankJunhaoYe/MathPaste-Obsidian.git"
  },
  "engines": {
    "node": ">=24.13.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && node esbuild.config.mjs",
    "p1:prepare": "npm run build && node scripts/p1/prepare.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-frontmatter": "2.0.1",
    "micromark-extension-frontmatter": "2.0.0",
    "obsidian": "1.14.4",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
